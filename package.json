{
	"name": "ha-finassists-repository",
	"description": "Home Assistant app, integration and release tooling for Fin Assist",
	"license": "MIT",
	"private": true,
	"type": "module",
	"workspaces": ["ha-finassists"],
	"scripts": {
		"build": "bun run --filter ha-finassists build",
		"check:version": "bun sync-release.ts --check",
		"commitlint": "commitlint --edit",
		"dev": "bun run --filter ha-finassists dev",
		"lint": "eslint --cache .",
		"lint:ci": "eslint --cache --cache-strategy content .",
		"lint:fix": "eslint --cache --fix .",
		"prepare": "husky",
		"start": "bun run --filter ha-finassists start",
		"test": "bun test",
		"typecheck": "tsc --noEmit && tsc --noEmit -p ha-finassists",
		"version": "changeset version && bun sync-release.ts"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@eslint/compat": "2.1.1",
		"@hexadrop/eslint-config": "1.0.11",
		"@hexadrop/tsconfig": "0.0.5",
		"@types/bun": "1.4.3",
		"eslint": "10.10.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import-x": "4.17.1",
		"husky": "9.1.7",
		"lint-staged": "17.5.1",
		"typescript": "6.0.3"
	}
}
