{
	"name": "ha-finassists",
	"version": "0.1.1",
	"description": "Household finance management for Home Assistant",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun run build:server && bun run build:web",
		"build:server": "mkdir -p dist && bun build --target=bun --packages=external --outfile=dist/server.js src/server.ts",
		"build:web": "bun run build:web:client && bun run build:web:renderer && cp dist/server-renderer.css dist/styles.css",
		"build:web:client": "mkdir -p dist && bun build --target=browser --format=esm --minify --outdir=dist src/app/client.tsx",
		"build:web:renderer": "mkdir -p dist && bun build --target=bun --format=esm --packages=bundle --outdir=dist src/app/shell/server-renderer.tsx",
		"commitlint": "commitlint --edit",
		"dev": "NODE_ENV=development bun --watch src/server.ts",
		"lint": "eslint --cache .",
		"lint:ci": "eslint --cache --cache-strategy content .",
		"lint:fix": "eslint --cache --fix .",
		"prepare": "husky",
		"start": "NODE_ENV=production bun run dist/server.js",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@inferdi/hono": "^6.1.0",
		"@inferdi/inferdi": "^6.1.0",
		"hono": "^4.13.13",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@eslint/compat": "2.1.1",
		"@hexadrop/eslint-config": "1.0.11",
		"@types/bun": "1.4.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"eslint": "10.10.0",
		"husky": "9.1.7",
		"lint-staged": "17.5.1",
		"typescript": "6.0.3"
	}
}
