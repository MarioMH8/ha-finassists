{
	"name": "ha-finassists",
	"version": "0.2.5",
	"description": "Household finance management for Home Assistant",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun run build:server && bun run build:web",
		"build:server": "mkdir -p dist && bun build --target=bun --packages=external --outfile=dist/server.js src/server.ts",
		"build:web": "bun run build:web:client && bun run build:web:renderer && cp dist/server-renderer.css dist/styles.css",
		"build:web:client": "mkdir -p dist && bun build --target=browser --format=esm --minify --external='/static/*' --outdir=dist src/app/client.tsx",
		"build:web:renderer": "mkdir -p dist && bun build --target=bun --format=esm --packages=bundle --external='/static/*' --outdir=dist src/app/shell/server-renderer.tsx",
		"dev": "NODE_ENV=development bun --watch src/server.ts",
		"start": "NODE_ENV=production bun run dist/server.js",
		"typecheck": "tsc -b .."
	},
	"dependencies": {
		"@inferdi/hono": "^6.1.0",
		"@inferdi/inferdi": "^6.1.0",
		"hono": "^4.13.13",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/bun": "1.4.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0"
	}
}
