{
	"extends": "@hexadrop/tsconfig",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "../node_modules/.cache/tsbuild/app.tsbuildinfo",
		"paths": {
			"@app/*": ["./src/app/*"],
			"@modules/*": ["./src/modules/*"]
		},
		"types": ["bun"],
		/*
		 * CSS Modules resolve to an index signature (`styles.card`), so requiring
		 * bracket access would rewrite every class lookup in the UI.
		 */
		"noPropertyAccessFromIndexSignature": false,
		"noEmit": true
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "types/**/*.d.ts"]
}
