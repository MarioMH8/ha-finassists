{
	"compilerOptions": {
		"target": "ESNext",
		"jsx": "react-jsx",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"types": ["bun"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "commitlint.config.ts"]
}
